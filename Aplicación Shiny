        eje_y <- if(length(term_eval) > 1) "Tratamiento" else term_eval[1]
        gg <- ggplot(datos_plot, aes_string(y = paste0("reorder(", eje_y, ", media_r)"), x = "media_r")) + geom_errorbarh(aes(xmin = media_r - disp, xmax = media_r + disp), height = 0.2) + geom_point(size = 3, color = "black") + geom_text(aes(label = sprintf("%.2f %s", media_r, trimws(Letra))), hjust = -0.1, vjust = -1.1, size = 4.2) + scale_x_continuous(expand = expansion(mult = c(0.1, 0.5))) + labs(x = paste("Media ±", toupper(input$ma_plot_err)), y = eje_y, title = paste("Medias:", y_v)) + theme_classic(base_size = 14) + theme(strip.text = element_text(size = 13, face = "bold"), strip.background = element_blank())
        if(!is.null(facet_var) && length(term_eval) == 1) { gg <- gg + facet_wrap(as.formula(paste("~", facet_var)), scales = "free_x", ncol = input$ma_facet_ncol) }
        lista_pmm[[y_v]] <<- gg
        
        G_primario <- G_vars[1]
        sum_df_int <- df_c %>% group_by(across(dplyr::all_of(c(G_primario, E)))) %>% summarise(Media = mean(.data[[y_v]], na.rm=TRUE), SE = sd(.data[[y_v]], na.rm=TRUE)/sqrt(n()), SD = sd(.data[[y_v]], na.rm=TRUE), .groups="drop") %>% mutate(disp = if(input$ma_plot_err=="se") SE else if(input$ma_plot_err=="sd") SD else SE*1.96); sum_df_int$disp[is.na(sum_df_int$disp)] <- 0
        gg_int <- ggplot(sum_df_int, aes_string(x = G_primario, y = "Media", color = E, group = E)) + geom_line(linewidth = 1.2) + geom_point(size = 4) + geom_errorbar(aes(ymin = Media - disp, ymax = Media + disp), width = 0.2, linewidth=0.8) + theme_classic(base_size = 14) + labs(title = paste("Interacción Trt x Ambiente:", y_v), y = "Media", x = G_primario, color = E)
        if(input$ma_facet && !is.null(input$ma_facet_var)) { gg_int <- gg_int + facet_wrap(as.formula(paste("~", input$ma_facet_var)), ncol = input$ma_facet_ncol) }
        lista_int[[y_v]] <<- gg_int
      })
    }
    if(length(lista_supuestos) > 0) vals$p_ma_sup <- patchwork::wrap_plots(lista_supuestos, ncol = 2)
    if(length(lista_pmm) > 0) vals$p_ma_pmm <- patchwork::wrap_plots(lista_pmm, ncol = if(length(lista_pmm)>1) 2 else 1)
    if(length(lista_int) > 0) vals$p_ma_int <- patchwork::wrap_plots(lista_int, ncol = if(length(lista_int)>1) 2 else 1)
  })
  
  # --- 3. GENERADOR DE LA TABLA RESUMEN MULTI-AMBIENTAL ---
  ma_resumen_data <- eventReactive(input$btn_gen_ma_resumen, {
    req(vals$datos, input$ma_y, input$ma_pmm_term_sel, input$ma_resumen_testigo, input$ma_dec)
    df <- vals$datos; vars_analizar <- input$ma_y; term_eval <- unlist(strsplit(input$ma_pmm_term_sel, ":")); testigo <- input$ma_resumen_testigo
    G_vars <- input$ma_gen; E <- input$ma_amb; Z <- input$ma_zafra; B <- input$ma_blk; covs <- input$ma_cov
    usar_zafra <- !is.null(Z) && Z != ""; G_str <- paste(G_vars, collapse = "*"); cov_str <- if(length(covs) > 0) paste(paste(covs, collapse=" + "), "+ ") else ""
    dec <- input$ma_dec; asc_vars <- isolate(input$ma_order_asc)
    
    fmt <- paste0("%.", dec, "f %s"); fmt_rel <- paste0("%.", dec, "f")
    
    if(length(term_eval) == 1) { df_resumen <- data.frame(Tratamiento = unique(as.character(df[[term_eval]][!is.na(df[[term_eval]])])), stringsAsFactors=FALSE) } 
    else { df_resumen <- data.frame(Tratamiento = unique(apply(df[, term_eval], 1, paste, collapse=":")), stringsAsFactors=FALSE) }
    
    lista_p_valores <- list(); todos_los_terminos_anova <- c()
    
    for(v in vars_analizar) {
      cols_limpieza <- c(v, G_vars, E, B, covs); if(usar_zafra) cols_limpieza <- c(cols_limpieza, Z)
      df_clean <- df[complete.cases(df[, cols_limpieza]), ]; df_clean[[v]] <- as.numeric(as.character(df_clean[[v]])); df_clean <- droplevels(df_clean)
      pvs_dict <- list()
      
      if(usar_zafra) {
        if(input$ma_lmm_type == "mod1") ran_eff <- paste0("(1|", Z, "/", E, ")")
        else if(input$ma_lmm_type == "mod2") ran_eff <- paste0("(1|", E, "/", B, ")")
        else ran_eff <- paste0("(1|", Z, "/", E, ") + (1|", E, ":", B, ")")
        mod_lmer <- tryCatch(lmerTest::lmer(as.formula(paste(v, "~", cov_str, G_str, "*", Z, "+", ran_eff)), data = df_clean), error=function(e) NULL)
        if(!is.null(mod_lmer)){ anv <- anova(mod_lmer); if("Pr(>F)" %in% colnames(anv)){ for(r in rownames(anv)) { pvs_dict[[trimws(r)]] <- anv[r, "Pr(>F)"] } } }
      } else {
        G_plus <- paste(G_vars, collapse = " + ")
        form_aov <- paste(v, "~", cov_str, G_plus, "+", E, "+", B, "+ Error(", B, "%in%", E, ") +", G_str, ":", E)
        mod_aov <- tryCatch(aov(as.formula(form_aov), data = df_clean), error=function(e) NULL)
        if(!is.null(mod_aov)){
          anv_sum <- summary(mod_aov)
          if(inherits(mod_aov, "aovlist")) { 
            for(i in seq_along(anv_sum)) { sm <- anv_sum[[i]][[1]]; if("Pr(>F)" %in% colnames(sm)){ for(r in rownames(sm)) { clean_r <- trimws(r); if(clean_r != "Residuals" && clean_r != "") { pvs_dict[[clean_r]] <- sm[r, "Pr(>F)"] } } } } 
          } else { sm <- anv_sum[[1]]; if("Pr(>F)" %in% colnames(sm)){ for(r in rownames(sm)) { clean_r <- trimws(r); if(clean_r != "Residuals" && clean_r != "") { pvs_dict[[clean_r]] <- sm[r, "Pr(>F)"] } } } }
        }
      }
      
      pvs <- unlist(pvs_dict); pvs_fmt <- ifelse(pvs < 0.001, "<0.001", sprintf("%.4f", pvs)); names(pvs_fmt) <- names(pvs_dict)
      lista_p_valores[[v]] <- pvs_fmt; todos_los_terminos_anova <- unique(c(todos_los_terminos_anova, names(pvs_dict)))
      
      es_cons_desc <- !(v %in% asc_vars)
      letras_df <- data.frame(Tratamiento=character(0), Letra=character(0), stringsAsFactors=FALSE)
      
      if(usar_zafra) {
        if(input$ma_lmm_type == "mod1") ran_eff <- paste0("(1|", Z, "/", E, ")")
        else if(input$ma_lmm_type == "mod2") ran_eff <- paste0("(1|", E, "/", B, ")")
        else ran_eff <- paste0("(1|", Z, "/", E, ") + (1|", E, ":", B, ")")
        mod_pmm <- tryCatch(lmerTest::lmer(as.formula(paste(v, "~", cov_str, G_str, "*", Z, "+", ran_eff)), data = df_clean), error=function(e) NULL)
        if(!is.null(mod_pmm)){
          em <- tryCatch(emmeans::emmeans(mod_pmm, as.formula(paste("~", paste(term_eval, collapse="*")))), error=function(e) NULL)
          if(!is.null(em)){
            cld_res <- as.data.frame(multcomp::cld(em, adjust = ifelse(input$ma_pmm=="Tukey", "tukey", "none"), Letters = letters, alpha = input$ma_alpha, reversed = es_cons_desc))
            col_letra <- if(".group" %in% names(cld_res)) ".group" else names(cld_res)[ncol(cld_res)]
            if(length(term_eval) > 1) { Trat_Join <- apply(cld_res[, term_eval, drop=FALSE], 1, paste, collapse=":") } else { Trat_Join <- as.character(cld_res[[term_eval]]) }
            letras_df <- data.frame(Tratamiento = Trat_Join, Letra = trimws(as.character(cld_res[[col_letra]])), stringsAsFactors = FALSE)
          }
        }
      } else {
        form_pmm_fix <- paste(v, "~", cov_str, paste(term_eval, collapse="*"))
        mod_pmm <- tryCatch(aov(as.formula(form_pmm_fix), data=df_clean), error=function(e) NULL)
        if(!is.null(mod_pmm) && df.residual(mod_pmm) > 0){
          if(input$ma_pmm == "Tukey" || input$ma_pmm == "Fisher (LSD)") { 
            if(input$ma_pmm == "Tukey") { pmm_res <- tryCatch(agricolae::HSD.test(mod_pmm, term_eval, alpha = input$ma_alpha), error=function(e) NULL) } 
            else { pmm_res <- tryCatch(agricolae::LSD.test(mod_pmm, term_eval, p.adj="none", alpha = input$ma_alpha), error=function(e) NULL) }
            if(!is.null(pmm_res)){
              sk_df <- data.frame(Tratamiento = as.character(rownames(pmm_res$groups)), Letra = trimws(as.character(pmm_res$groups$groups)), stringsAsFactors = FALSE)
              if(!es_cons_desc) sk_df$Letra <- rev_let(sk_df$Letra)
              letras_df <- sk_df
            }
          } else { 
            if(length(term_eval) > 1) { df_clean$SK_INT <- interaction(df_clean[, term_eval], sep=":"); mod_sk <- tryCatch(aov(as.formula(paste(v, "~", cov_str, "SK_INT")), data=df_clean), error=function(e) NULL); if(!is.null(mod_sk)){ sk_res <- tryCatch(ScottKnott::SK(mod_sk, which = "SK_INT", sig.level = input$ma_alpha, dispersion = "se"), error=function(e) NULL); if(!is.null(sk_res)){ sk_df <- data.frame(Tratamiento = as.character(rownames(sk_res$groups)), Letra = trimws(as.character(sk_res$groups$Groups)), stringsAsFactors = FALSE); if(!es_cons_desc) sk_df$Letra <- rev_let(sk_df$Letra); letras_df <- sk_df } } } 
            else { sk_res <- tryCatch(ScottKnott::SK(mod_pmm, which = term_eval, sig.level = input$ma_alpha, dispersion = "se"), error=function(e) NULL); if(!is.null(sk_res)){ sk_df <- data.frame(Tratamiento = as.character(rownames(sk_res$groups)), Letra = trimws(as.character(sk_res$groups$Groups)), stringsAsFactors = FALSE); if(!es_cons_desc) sk_df$Letra <- rev_let(sk_df$Letra); letras_df <- sk_df } }
          }
        }
      }
      
      if(length(term_eval) > 1) { df_clean$Trat_Join <- apply(df_clean[, term_eval, drop=FALSE], 1, paste, collapse=":") } else { df_clean$Trat_Join <- as.character(df_clean[[term_eval]]) }
      medias_reales <- df_clean %>% group_by(Trat_Join) %>% summarise(Media = mean(.data[[v]], na.rm=TRUE), .groups="drop") %>% rename(Tratamiento = Trat_Join)
      
      if(nrow(letras_df) > 0) { medias_finales <- medias_reales %>% left_join(letras_df, by = "Tratamiento") } else { medias_finales <- medias_reales; medias_finales$Letra <- "" }
      
      media_testigo <- medias_finales$Media[medias_finales$Tratamiento == testigo]; if(length(media_testigo) == 0 || is.na(media_testigo) || media_testigo == 0) { media_testigo_fallback <- mean(df_clean[[v]], na.rm=TRUE); media_testigo <- ifelse(is.na(media_testigo_fallback) || media_testigo_fallback == 0, 1, media_testigo_fallback) }
      
      medias_finales <- medias_finales %>% mutate(
        Letra = ifelse(is.na(Letra), "", Letra),
        Texto_Combinado = ifelse(is.na(Media), "-", sprintf(fmt, Media, Letra)), 
        Relativo_Calc = case_when(Tratamiento == testigo ~ 1, is.na(Media) ~ NA_real_, TRUE ~ Media / media_testigo),
        Relativo = ifelse(is.na(Relativo_Calc), "-", sprintf(fmt_rel, Relativo_Calc))
      )
      
      df_resumen <- df_resumen %>% left_join(medias_finales %>% dplyr::select(Tratamiento, Texto_Combinado, Relativo), by = "Tratamiento")
      df_resumen[is.na(df_resumen)] <- "-"
      colnames(df_resumen)[ncol(df_resumen)-1] <- v; colnames(df_resumen)[ncol(df_resumen)] <- paste(v, "Rel")
    }
    
    cols_relativas <- grep("Rel$", colnames(df_resumen), value = TRUE)
    cols_restantes <- setdiff(colnames(df_resumen), c("Tratamiento", cols_relativas))
    df_resumen <- df_resumen %>% dplyr::select(Tratamiento, dplyr::all_of(cols_restantes), dplyr::all_of(cols_relativas))
    df_resumen <- df_resumen[order(df_resumen$Tratamiento), ]; df_resumen <- data.frame(`No Trat` = paste0("T", 1:nrow(df_resumen)), df_resumen, check.names = FALSE)
    df_resumen <- df_resumen %>% mutate(across(everything(), as.character))
    
    for(termino in todos_los_terminos_anova) { 
      fila_p <- c("", paste("P-valor (", termino, ")", sep=""))
      for (col in colnames(df_resumen)[-c(1,2)]) { if(col %in% vars_analizar) { val <- lista_p_valores[[col]][termino]; if(is.na(val) || is.null(val)) val <- "-"; fila_p <- c(fila_p, val) } else { fila_p <- c(fila_p, "") } }
      df_resumen <- rbind(df_resumen, fila_p) 
    }
    return(df_resumen)
  })
  
  output$ma_tabla_resumen <- renderDT({ req(ma_resumen_data()); datatable(ma_resumen_data(), extensions = 'Buttons', options = list(dom = 'Bfrtip', buttons = c('copy', 'excel'), pageLength = 25), rownames = FALSE, class = "cell-border stripe") })
  
  output$ma_plots <- renderPlot({ req(vals$p_ma_sup); vals$p_ma_sup })
