  observeEvent(input$run_lmm, {
    req(vals$datos, input$lmm_y, input$lmm_fixed, input$lmm_random, input$lmm_engine)
    
    txt_diag <- ""; txt_anova <- ""; txt_sup <- ""
    lista_sup_plots <- list(); lista_ranef_plots <- list()
    lista_mod <- list(); lista_df <- list(); lista_anova_tab <- list()
    
    for(y_var in input$lmm_y) {
      local({
        y_v <- y_var; df <- vals$datos
        df[[y_v]] <- suppressWarnings(as.numeric(as.character(df[[y_v]])))
        df <- df[!is.na(df[[y_v]]), ]
        if(nrow(df) < 3) { txt_diag <<- paste0(txt_diag, "\n[!] Datos insuficientes para ", y_v, "\n"); return() }
        
        tryCatch({
          # 1. AJUSTE DEL MODELO
          engine_use <- input$lmm_engine
          if(input$lmm_varcor != "none" && engine_use == "lme4") engine_use <- "nlme"
          
          if(engine_use == "lme4") {
            mod <- lmerTest::lmer(as.formula(paste(y_v, "~", input$lmm_fixed, "+", input$lmm_random)), data = df)
            m_class <- "lme4"; anova_tab <- anova(mod)
          } else {
            fix_form <- as.formula(paste(y_v, "~", input$lmm_fixed))
            ran_str <- gsub("\\(|\\)", "", trimws(input$lmm_random)) 
            if(!grepl("^~", ran_str)) ran_str <- paste("~", ran_str)
            ran_form <- as.formula(ran_str)
            
            if(input$lmm_varcor == "none") {
              mod <- nlme::lme(fixed = fix_form, random = ran_form, data = df, na.action = na.omit)
            } else {
              req(input$lmm_varcor_var); v_cor <- input$lmm_varcor_var
              if(input$lmm_varcor == "varIdent") {
                df[[v_cor]] <- as.factor(df[[v_cor]]); pesos <- nlme::varIdent(form = as.formula(paste("~ 1 |", v_cor)))
              } else {
                df[[v_cor]] <- suppressWarnings(as.numeric(as.character(df[[v_cor]])))
                if(input$lmm_varcor == "varPower") pesos <- nlme::varPower(form = as.formula(paste("~", v_cor)))
                if(input$lmm_varcor == "varExp") pesos <- nlme::varExp(form = as.formula(paste("~", v_cor)))
                if(input$lmm_varcor == "varConstPower") pesos <- nlme::varConstPower(form = as.formula(paste("~", v_cor)))
              }
              mod <- nlme::lme(fixed = fix_form, random = ran_form, weights = pesos, data = df, na.action = na.omit)
            }
            m_class <- "nlme"; anova_tab <- anova(mod)
          }
          
          lista_mod[[y_v]] <<- mod; lista_df[[y_v]] <<- df; lista_anova_tab[[y_v]] <<- anova_tab
          
          # Textos de Diagnóstico
          txt_diag <<- paste0(txt_diag, "\n===============================================================\n  DIAGNÓSTICO DEL MODELO: ", toupper(y_v), "\n===============================================================\nMotor Analítico: ", m_class, "\n\n--- 1. MÉTRICAS DE AJUSTE ---\nAIC: ", round(AIC(mod),2), " | BIC: ", round(BIC(mod),2), " | Log-Verosimilitud: ", round(as.numeric(logLik(mod)),2), "\n")
          r2 <- tryCatch(MuMIn::r.squaredGLMM(mod), error=function(e) NULL)
          if(!is.null(r2)) txt_diag <<- paste0(txt_diag, sprintf("\n--- 2. PODER EXPLICATIVO (Pseudo-R²) ---\nR² Marginal: %.4f\nR² Condicional: %.4f\n", r2[1,1], r2[1,2]))
          vif_val <- tryCatch(car::vif(mod), error=function(e) NULL)
          if(!is.null(vif_val)) txt_diag <<- paste0(txt_diag, "\n--- 3. MULTICOLINEALIDAD (VIF) ---\n", paste(capture.output(print(vif_val)), collapse="\n"), "\n")
          txt_diag <<- paste0(txt_diag, "\n--- 4. COEFICIENTES ESTIMADOS ---\n")
          if(m_class == "lme4") txt_diag <<- paste0(txt_diag, paste(capture.output(print(round(summary(mod)$coefficients, 4))), collapse="\n"), "\n") else txt_diag <<- paste0(txt_diag, paste(capture.output(print(round(summary(mod)$tTable, 4))), collapse="\n"), "\n")
          
          txt_anova <<- paste0(txt_anova, "\n===============================================================\n  ANDEVA: PRUEBAS DE SIGNIFICANCIA GLOBAL (Wald F-tests)\n===============================================================\n", paste(capture.output(print(anova_tab)), collapse="\n"), "\n")
          
          # Supuestos y Gráficos DHARMa/Pearson
          res_p <- resid(mod, type="pearson"); fit_v <- fitted(mod)
          txt_sup <<- paste0(txt_sup, "\n===============================================================\n   PRUEBAS FORMALES DE SUPUESTOS: ", toupper(y_v), "\n===============================================================\n")
          p_shap <- tryCatch(shapiro.test(res_p)$p.value, error=function(e) NA)
          txt_sup <<- paste0(txt_sup, sprintf("\n1. NORMALIDAD (Shapiro-Wilk):\n   P-valor = %.4f --> %s\n", p_shap, ifelse(!is.na(p_shap) && p_shap < 0.05, "[ALERTA] Residuos No Normales.", "[OK] Distribución Normal.")))
          
          txt_sup <<- paste0(txt_sup, "\n2. HOMOCEDASTICIDAD (Varianza Constante):\n")
          factores_modelo <- all.vars(as.formula(paste("~", input$lmm_fixed)))
          p_var_hechas <- FALSE
          for(f in factores_modelo) {
            if(is.factor(df[[f]]) || is.character(df[[f]])) {
              estr_f <- as.factor(df[[f]])
              if(length(levels(estr_f)) > 1) {
                p_bart <- tryCatch(bartlett.test(res_p ~ estr_f)$p.value, error=function(e) NA)
                p_lev <- tryCatch(car::leveneTest(res_p ~ estr_f, center="median")$`Pr(>F)`[1], error=function(e) NA)
                txt_sup <<- paste0(txt_sup, sprintf("   Evaluando contra factor '%s':\n   - Bartlett (Paramétrico): P-valor = %.4f %s\n   - Levene (Robusto): P-valor = %.4f %s\n", f, p_bart, ifelse(!is.na(p_bart) && p_bart < 0.05, "-> [HETEROCEDASTICIDAD]", "-> [OK]"), p_lev, ifelse(!is.na(p_lev) && p_lev < 0.05, "-> [HETEROCEDASTICIDAD]", "-> [OK]")))
                p_var_hechas <- TRUE
              }
            }
          }
          if(!p_var_hechas) txt_sup <<- paste0(txt_sup, "   (No se detectaron factores categóricos para pruebas de Bartlett y Levene)\n")
          
          tryCatch({
            sim_res <- DHARMa::simulateResiduals(fittedModel = mod, plot = FALSE)
            unif <- DHARMa::testUniformity(sim_res, plot = FALSE)
            disp <- DHARMa::testDispersion(sim_res, plot = FALSE)
            txt_sup <<- paste0(txt_sup, "\n3. ANÁLISIS DHARMa (Simulación):\n   - Uniformidad: P-valor = ", sprintf("%.4f", unif$p.value), " ", ifelse(unif$p.value < 0.05, "-> [DESVIACIÓN]", "-> [OK]"), "\n   - Dispersión:  P-valor = ", sprintf("%.4f", disp$p.value), " ", ifelse(disp$p.value < 0.05, "-> [SOBRE/SUB DISPERSIÓN]", "-> [OK]"), "\n")
          }, error = function(e) { })
          
          df_diag <- data.frame(Fitted=fit_v, Residuos=res_p)
          p1 <- ggplot(df_diag, aes(sample=Residuos)) + stat_qq(color="#2c3e50") + stat_qq_line(color="red") + theme_classic() + labs(title=paste("QQ-Plot:", y_v))
          p2 <- ggplot(df_diag, aes(x=Fitted, y=Residuos)) + geom_point(color="#2c3e50", alpha=0.6) + geom_hline(yintercept=0, color="red", linetype="dashed") + theme_classic() + labs(title="Fitted vs Resids")
          
          factor_graf <- if(m_class=="nlme" && input$lmm_varcor=="varIdent") input$lmm_varcor_var else all.vars(as.formula(paste("~", input$lmm_fixed)))[1]
          if(!is.null(factor_graf) && factor_graf %in% names(df)) {
            df_diag$Factor <- as.factor(df[[factor_graf]])
            p3 <- ggplot(df_diag, aes(x=Factor, y=Residuos)) + geom_boxplot(fill=ifelse(m_class=="nlme" && input$lmm_varcor!="none", "#2ecc71", "#3498db")) + geom_hline(yintercept=0, color="red", linetype="dashed") + theme_classic() + labs(title=paste("Cajas vs", factor_graf), x=factor_graf)
          } else { p3 <- ggplot(df_diag, aes(x=Residuos)) + geom_histogram(fill="#3498db", bins=15) + theme_classic() }
          lista_sup_plots[[y_v]] <<- patchwork::wrap_plots(p1, p2, p3, ncol=3)
          
          # Gráfico Profesional de Pendientes Aleatorias
          x_var <- if(length(factores_modelo)>0) factores_modelo[1] else NULL
          ran_str <- input$lmm_random
          grp_var <- if(grepl("\\|", ran_str)) trimws(unlist(strsplit(gsub("\\)", "", ran_str), "/"))[1]) else NULL
          if(grepl("\\|", grp_var)) grp_var <- trimws(unlist(strsplit(grp_var, "\\|"))[2]) # Limpiar si tiene intercepto
          
          if(!is.null(x_var) && !is.null(grp_var) && x_var %in% names(df) && grp_var %in% names(df)) {
            df$Pred_Mixed <- predict(mod)
            if(m_class=="lme4") df$Pred_Fixed <- predict(mod, re.form=NA) else df$Pred_Fixed <- predict(mod, level=0)
            
            p_ran <- ggplot(df, aes_string(x=x_var, y=y_v, color=grp_var)) + 
              geom_point(size=3, alpha=0.6) + 
              geom_line(aes(y=Pred_Mixed, group=.data[[grp_var]]), size=1.2, alpha=0.8) + 
              scale_color_viridis_d(option="plasma") + theme_bw(base_size=15) + 
              theme(panel.grid.minor = element_blank(), legend.position="right", plot.title=element_text(face="bold")) + 
              labs(title=paste("Efectos Aleatorios (Tendencias):", y_v), subtitle=paste("Colores:", grp_var, "| Línea negra: Tendencia Poblacional"), x=x_var, y=y_v, color="ID")
            
            if(is.numeric(df[[x_var]])) { p_ran <- p_ran + geom_smooth(aes(group=1), method="lm", formula=y~x, color="black", size=2.5, se=FALSE) } else { p_ran <- p_ran + geom_line(aes(y=Pred_Fixed, group=1), color="black", size=2.5) }
            lista_ranef_plots[[y_v]] <<- p_ran
          }
          
        }, error = function(e) cat("\n[!] Fallo en ", y_v, ": ", e$message, "\n"))
      })
    }
    
    # Almacenar en Vals para las salidas
    vals$lmm_diag_txt <- txt_diag; vals$lmm_anova_txt <- txt_anova; vals$lmm_sup_txt <- txt_sup
    vals$lmm_sup_plots <- lista_sup_plots; vals$lmm_ranef_plots <- lista_ranef_plots
    vals$lmm_mod_list <- lista_mod; vals$lmm_df_list <- lista_df; vals$lmm_anova_tab_list <- lista_anova_tab
  })
  
  # --- CÁLCULO REACTIVO DE LA PRUEBA MÚLTIPLE DE MEDIAS (PMM) ---
  lmm_pmm_calc <- reactive({
    req(vals$lmm_mod_list, vals$lmm_df_list, input$lmm_pmm_term, input$lmm_pmm_method, input$lmm_fixed)
    txt_pmm <- ""; lista_letras <- list(); lista_plots <- list()
    term_eval <- unlist(strsplit(input$lmm_pmm_term, ":")); alpha_val <- input$lmm_pmm_alpha
    
    for(y_v in names(vals$lmm_mod_list)) {
      df_c <- vals$lmm_df_list[[y_v]]
      # Fusión en columna estática para eludir fallas de agricolae con interacciones
      df_c$PMM_VAR <- as.factor(apply(df_c[, term_eval, drop=FALSE], 1, paste, collapse=":"))
      mod_pmm <- tryCatch(aov(as.formula(paste(y_v, "~ PMM_VAR")), data=df_c), error=function(e) NULL)
      
      if(!is.null(mod_pmm)) {
        txt_pmm <- paste0(txt_pmm, "\n=== PMM (", input$lmm_pmm_method, "): ", toupper(y_v), " ===\n")
        if(input$lmm_pmm_method == "Tukey") { res_m <- tryCatch(HSD.test(mod_pmm, "PMM_VAR", alpha=alpha_val), error=function(e) NULL) }
        else if(input$lmm_pmm_method == "Fisher (LSD)") { res_m <- tryCatch(LSD.test(mod_pmm, "PMM_VAR", p.adj="none", alpha=alpha_val), error=function(e) NULL) }
        else if(input$lmm_pmm_method == "Duncan") { res_m <- tryCatch(duncan.test(mod_pmm, "PMM_VAR", alpha=alpha_val), error=function(e) NULL) }
        else { res_m <- tryCatch(SNK.test(mod_pmm, "PMM_VAR", alpha=alpha_val), error=function(e) NULL) }
        
        if(!is.null(res_m)) {
          txt_pmm <- paste0(txt_pmm, paste(capture.output(print(res_m$groups)), collapse="\n"), "\n")
          letras_df <- data.frame(Tratamiento=trimws(rownames(res_m$groups)), Letra=trimws(res_m$groups$groups), stringsAsFactors=FALSE)
          lista_letras[[y_v]] <- letras_df
          
          # Gráfico PMM Vivo (ByN)
          group_cols <- term_eval; facet_var <- NULL
          if(input$lmm_pmm_facet && !is.null(input$lmm_pmm_facet_var) && input$lmm_pmm_facet_var != "") { facet_var <- input$lmm_pmm_facet_var; group_cols <- unique(c(group_cols, facet_var)) }
          
          df_stats <- df_c %>% group_by(across(dplyr::all_of(group_cols))) %>% summarise(media_r = mean(.data[[y_v]], na.rm=TRUE), se_val = sd(.data[[y_v]], na.rm=TRUE)/sqrt(n()), .groups="drop")
          if(length(term_eval) > 1) { df_stats$Tratamiento <- apply(df_stats[, term_eval, drop=FALSE], 1, function(x) paste(trimws(as.character(x)), collapse=":")) } else { df_stats$Tratamiento <- trimws(as.character(df_stats[[term_eval]])) }
          
          datos_plot <- df_stats %>% left_join(letras_df, by="Tratamiento")
          eje_y <- if(length(term_eval) > 1) "Tratamiento" else term_eval[1]
          
          gg <- ggplot(datos_plot, aes_string(y = paste0("reorder(", eje_y, ", media_r)"), x = "media_r")) + 
            geom_errorbarh(aes(xmin=media_r-se_val, xmax=media_r+se_val), height=0.2, color="black", size=0.8) + 
            geom_point(size=4, color="black") + 
            geom_text(aes(label=sprintf("%.2f %s", media_r, ifelse(is.na(Letra), "", Letra))), hjust=-0.2, vjust=-0.8, size=4.5, color="black") + 
            scale_x_continuous(expand=expansion(mult=c(0.1, 0.5))) + 
            labs(x="Media Real ± SE", y=eje_y, title=paste(y_v, "-", input$lmm_pmm_method)) + 
