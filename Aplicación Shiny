  observeEvent(input$btn_pop_mlg_pmm, { req(vals$p_mlg_pmm); if(interactive()){ dev.new(noRStudioGD=T); print(vals$p_mlg_pmm) } })
  
  # =====================================================================
  # --- PLAGAS: DINÁMICA POBLACIONAL Y ÁREA BAJO LA CURVA (AUC) ---
  # =====================================================================
  output$dyn_vars_ui <- renderUI({ 
    req(vals$datos); vars <- names(vals$datos)
    tagList(
      selectInput("dyn_time", "Variable Temporal Continua (Ej: Días, Semanas):", choices = c("Seleccione..."="", names(dplyr::select_if(vals$datos, is.numeric)))), 
      selectInput("dyn_y", "Densidad/Conteo de Plaga (Y):", choices = c("Seleccione..."="", names(dplyr::select_if(vals$datos, is.numeric)))), 
