  })
  
  observeEvent(input$run_sp_bar, {
    req(vals$datos, input$sp_bar_y, input$sp_bar_x)
    
    df <- vals$datos
    y_var <- input$sp_bar_y
    x_var <- input$sp_bar_x
    facet_var <- input$sp_bar_facet
    color_var <- if(input$sp_bar_color_by == "x") x_var else (if(facet_var != "") facet_var else x_var)
    
    # Limpieza básica
    df[[y_var]] <- as.numeric(as.character(df[[y_var]]))
    df[[x_var]] <- as.factor(df[[x_var]])
    if(facet_var != "") df[[facet_var]] <- as.factor(df[[facet_var]])
    
    cols_to_keep <- c(y_var, x_var)
    if(facet_var != "") cols_to_keep <- c(cols_to_keep, facet_var)
    df_clean <- df[complete.cases(df[, cols_to_keep]), ]
    
    tryCatch({
      # 1. Agrupación y cálculo de estadísticos (Media, SD, SE, IC)
      grouping_vars <- if(facet_var != "") c(x_var, facet_var) else c(x_var)
      
      df_sum <- df_clean %>% 
        group_by(across(all_of(grouping_vars))) %>% 
        summarise(
          Media = mean(.data[[y_var]], na.rm = TRUE),
          N = n(),
          SD = sd(.data[[y_var]], na.rm = TRUE),
          SE = SD / sqrt(N),
          .groups = "drop"
        ) %>%
        mutate(
          IC = SE * qt(0.975, df = ifelse(N > 1, N - 1, 1)),
          Error_Val = case_when(
            input$sp_bar_err == "se" ~ SE,
            input$sp_bar_err == "sd" ~ SD,
            input$sp_bar_err == "ic" ~ IC,
            TRUE ~ 0
          )
        )
      
      # Evitar NAs en barras de error si solo hay 1 dato
      df_sum$Error_Val[is.na(df_sum$Error_Val)] <- 0
      
      # 2. Construcción del Gráfico Base
      p <- ggplot(df_sum, aes_string(x = x_var, y = "Media", fill = color_var)) +
        geom_bar(stat = "identity", color = "black", linewidth = 0.5, width = 0.7)
      
      # 3. Añadir Barras de Error si el usuario lo pide
      if(input$sp_bar_err != "none") {
        p <- p + geom_errorbar(aes(ymin = Media - Error_Val, ymax = Media + Error_Val), 
                               width = 0.2, linewidth = 0.8)
      }
      
      # 4. Facetado (Si aplica)
      if(facet_var != "") {
        p <- p + facet_wrap(as.formula(paste("~", facet_var)), scales = "free_x") +
          theme(strip.background = element_rect(fill = "#2c3e50"),
                strip.text = element_text(color = "white", face = "bold", size = 12))
      }
      
      # 5. Estética de Colores
      if(input$sp_bar_pal %in% c("viridis", "plasma", "mako")) {
        p <- p + scale_fill_viridis_d(option = input$sp_bar_pal)
      } else {
        p <- p + scale_fill_brewer(palette = input$sp_bar_pal)
      }
      
      # 6. Tema Visual
      tema_seleccionado <- match.fun(input$sp_bar_theme)
      p <- p + tema_seleccionado(base_size = 15) +
        theme(axis.text.x = element_text(angle = 45, hjust = 1, face = "bold"),
              legend.position = "right",
              legend.title = element_text(face = "bold"))
      
      # 7. Etiquetas Personalizadas
      label_x <- if(input$sp_bar_xlab != "") input$sp_bar_xlab else x_var
      label_y <- if(input$sp_bar_ylab != "") input$sp_bar_ylab else paste("Promedio de", y_var)
      
      p <- p + labs(x = label_x, y = label_y, fill = color_var)
      
      vals$p_sp_bar <- p
      output$sp_bar_plot <- renderPlot({ p }, res = 100)
      
    }, error=function(e) {
      showNotification(paste("Error generando gráfico:", e$message), type="error")
    })
  })
  
  observeEvent(input$btn_pop_sp_bar, {
    req(vals$p_sp_bar)
    if(interactive()){
      dev.new(noRStudioGD = TRUE, width = 12, height = 8)
      print(vals$p_sp_bar)
    }
  })}
