      } else if (arr == "Parcelas Subdivididas") { form_anova <- paste(v, "~", cov_str, base_str, A, "*", B, "*", input$fac_C, "+ Error(", input$fac_blk, "/", A, "/", B, ")"); form_fix <- paste(v, "~", cov_str, base_str, A, "*", B, "*", input$fac_C) 
      } else if (arr == "Franjas") { form_anova <- paste(v, "~", cov_str, base_str, A, "*", B, "+ Error(", input$fac_blk, "/(", A, "+", B, "))"); form_fix <- paste(v, "~", cov_str, base_str, A, "*", B) 
      } else if (arr == "Franjas Divididas") { form_anova <- paste(v, "~", cov_str, A, "*", B, "*", input$fac_C, "+ Error(", input$fac_blk, "/(", A, "*", B, "))"); form_fix <- paste(v, "~", cov_str, base_str, A, "*", B, "*", input$fac_C) }
      
      mod_anova <- tryCatch(aov(as.formula(form_anova), data = df_clean), error = function(e) NULL)
      mod_fix <- tryCatch(aov(as.formula(form_fix), data = df_clean), error = function(e) NULL)
      
      if(is.null(mod_anova) || is.null(mod_fix)) {
        df_resumen[[v]] <- "-"
        df_resumen[[paste(v, "Rel")]] <- "-"
        next
      }
      
      # FIX 2: Diccionario de P-valores para capturar correctamente la interacción en Split-Plots (se guarda el ÚLTIMO que aparezca)
      pvs_dict <- list()
      if(inherits(mod_anova, "aovlist")) { 
        for(i in 1:length(summary(mod_anova))) { 
          sm <- summary(mod_anova)[[i]][[1]]; rn <- rownames(sm); rn <- rn[rn != "Residuals" & trimws(rn) != ""]
          for(r in rn) { p <- sm[r, "Pr(>F)"]; if(!is.na(p) && !is.null(p)) pvs_dict[[trimws(r)]] <- p } 
        } 
      } else { 
        sm <- summary(mod_anova)[[1]]; rn <- rownames(sm); rn <- rn[rn != "Residuals" & trimws(rn) != ""]
        for(r in rn) { p <- sm[r, "Pr(>F)"]; if(!is.na(p) && !is.null(p)) pvs_dict[[trimws(r)]] <- p } 
      }
      
      nombres_pvs <- names(pvs_dict)
      pvs <- unlist(pvs_dict)
      pvs_fmt <- ifelse(pvs < 0.001, "<0.001", sprintf("%.4f", pvs)); names(pvs_fmt) <- nombres_pvs
      lista_p_valores[[v]] <- pvs_fmt; todos_los_terminos_anova <- unique(c(todos_los_terminos_anova, nombres_pvs))
      
      if(input$fac_pmm == "Scott-Knott") { 
        if(length(term_eval) > 1) { 
          df_clean$SK_INT <- as.factor(do.call(paste, c(df_clean[, term_eval, drop=FALSE], sep=":")))
          mod_sk <- tryCatch(aov(as.formula(paste(v, "~", cov_str, base_str, "SK_INT")), data=df_clean), error=function(e) NULL)
          if(!is.null(mod_sk)) {
            sk_res <- SK(mod_sk, which = "SK_INT", sig.level = alpha_val, dispersion = "se")
            tabla_letras <- data.frame(Tratamiento = as.character(rownames(sk_res$groups)), Letra = as.character(sk_res$groups$Groups), stringsAsFactors = FALSE) 
          } else { tabla_letras <- data.frame(Tratamiento=character(0), Letra=character(0)) }
        } else { 
          sk_res <- SK(mod_fix, which = term, sig.level = alpha_val, dispersion = "se")
          tabla_letras <- data.frame(Tratamiento = as.character(rownames(sk_res$groups)), Letra = as.character(sk_res$groups$Groups), stringsAsFactors = FALSE) 
        } 
      } else { 
        if(input$fac_pmm == "Tukey") pmm_res <- HSD.test(mod_fix, term_eval, alpha = alpha_val) else pmm_res <- LSD.test(mod_fix, term_eval, p.adj = "none", alpha = alpha_val)
        tabla_letras <- data.frame(Tratamiento = as.character(rownames(pmm_res$groups)), Letra = as.character(pmm_res$groups$groups), stringsAsFactors = FALSE) 
      }
      
      if(length(term_eval) > 1) { df_clean$Tratamiento <- do.call(paste, c(df_clean[, term_eval, drop=FALSE], sep=":")) } else { df_clean$Tratamiento <- as.character(df_clean[[term_eval]]) }
      
      medias_var <- df_clean %>% group_by(Tratamiento) %>% summarise(Media = mean(.data[[v]], na.rm=TRUE), .groups="drop") %>% left_join(tabla_letras, by = "Tratamiento")
      
      media_testigo <- medias_var$Media[medias_var$Tratamiento == testigo]
      if(length(media_testigo) == 0 || is.na(media_testigo) || media_testigo == 0) { 
        media_testigo_fallback <- mean(df_clean[[v]], na.rm = TRUE)
        media_testigo <- ifelse(is.na(media_testigo_fallback) || media_testigo_fallback == 0, 1, media_testigo_fallback) 
      }
      
      medias_var <- medias_var %>% mutate(
        Texto_Combinado = ifelse(is.na(Media), "-", sprintf(fmt, Media, trimws(Letra))),
        Relativo_Calc = case_when(
          Tratamiento == testigo ~ 1,
          is.na(Media) ~ NA_real_,
          TRUE ~ Media / media_testigo
        ),
        Relativo = ifelse(is.na(Relativo_Calc), "-", sprintf(fmt_rel, Relativo_Calc))
      )
      
      df_resumen <- df_resumen %>% left_join(medias_var %>% dplyr::select(Tratamiento, Texto_Combinado, Relativo), by = "Tratamiento")
      df_resumen[is.na(df_resumen)] <- "-"
      colnames(df_resumen)[ncol(df_resumen)-1] <- v; colnames(df_resumen)[ncol(df_resumen)] <- paste(v, "Rel")
    }
    
    cols_relativas <- grep("Rel$", colnames(df_resumen), value = TRUE)
    cols_restantes <- setdiff(colnames(df_resumen), c("Tratamiento", cols_relativas))
    df_resumen <- df_resumen %>% dplyr::select(Tratamiento, dplyr::all_of(cols_restantes), dplyr::all_of(cols_relativas))
    
    df_resumen <- df_resumen[order(df_resumen$Tratamiento), ]; df_resumen <- data.frame(`No Trat` = paste0("T", 1:nrow(df_resumen)), df_resumen, check.names = FALSE)
    df_resumen <- df_resumen %>% mutate(across(everything(), as.character)); todos_los_terminos_anova <- sort(todos_los_terminos_anova)
    
    for(termino in todos_los_terminos_anova) { 
      fila_p <- c("", paste("P-valor (", termino, ")", sep=""))
      for (col in colnames(df_resumen)[-c(1,2)]) { 
        if(col %in% vars_analizar) { 
          val <- lista_p_valores[[col]][termino]
          if(is.na(val) || is.null(val)) val <- "-"
          fila_p <- c(fila_p, val) 
        } else { fila_p <- c(fila_p, "") } 
      }
      df_resumen <- rbind(df_resumen, fila_p) 
    }
    return(df_resumen)
  })
  
