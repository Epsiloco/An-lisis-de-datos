  # --- TABLA RESUMEN MULTIPLE ---
  lmm_resumen_data <- eventReactive(input$btn_gen_lmm_resumen, {
    req(vals$lmm_mod_list, input$lmm_pmm_term, input$lmm_resumen_testigo, input$lmm_dec)
    vars_y <- names(vals$lmm_mod_list); term_eval <- unlist(strsplit(input$lmm_pmm_term, ":"))
    testigo <- input$lmm_resumen_testigo; dec <- input$lmm_dec
    fmt <- paste0("%.", dec, "f %s"); fmt_rel <- paste0("%.", dec, "f")
    
    df_base <- vals$datos[complete.cases(vals$datos[, term_eval, drop=FALSE]), , drop=FALSE]
    if(length(term_eval) == 1) { niveles_esq <- unique(trimws(as.character(df_base[[term_eval]]))) } else { niveles_esq <- unique(apply(df_base[, term_eval, drop=FALSE], 1, paste, collapse=":")) }
    df_resumen <- data.frame(Tratamiento = niveles_esq, stringsAsFactors=FALSE)
    
    lista_p <- list(); terminos_p <- c()
    
    for(v in vars_y) {
      df_y <- vals$lmm_df_list[[v]]; anv <- vals$lmm_anova_tab_list[[v]]
      letras <- tryCatch(lmm_pmm_calc()$letras[[v]], error=function(e) NULL)
      
      pvs_dict <- list()
      if(!is.null(anv) && "Pr(>F)" %in% colnames(anv)) {
        for(r in rownames(anv)) { cl_r <- trimws(gsub("`", "", r)); if(cl_r != "Residuals" && cl_r != "") pvs_dict[[cl_r]] <- anv[r, "Pr(>F)"] }
      }
      lista_p[[v]] <- pvs_dict; terminos_p <- unique(c(terminos_p, names(pvs_dict)))
      
      df_y$PMM_VAR <- if(length(term_eval)>1) apply(df_y[, term_eval, drop=FALSE], 1, paste, collapse=":") else trimws(as.character(df_y[[term_eval]]))
      medias <- df_y %>% group_by(Tratamiento = PMM_VAR) %>% summarise(Media = mean(.data[[v]], na.rm=TRUE), .groups="drop")
      if(!is.null(letras) && nrow(letras)>0) medias <- medias %>% left_join(letras, by="Tratamiento") else medias$Letra <- ""
      
      m_testigo <- medias$Media[medias$Tratamiento == testigo]; if(length(m_testigo)==0 || is.na(m_testigo) || m_testigo==0) m_testigo <- mean(df_y[[v]], na.rm=TRUE)
      
      medias <- medias %>% mutate(
        Letra = ifelse(is.na(Letra), "", Letra),
        Texto_Comb = ifelse(is.na(Media), "-", sprintf(fmt, Media, Letra)),
        Relativo_c = case_when(Tratamiento == testigo ~ 1, is.na(Media) ~ NA_real_, TRUE ~ Media / m_testigo),
        Relativo = ifelse(is.na(Relativo_c), "-", sprintf(fmt_rel, Relativo_c))
      )
      
      df_resumen <- df_resumen %>% left_join(medias %>% dplyr::select(Tratamiento, Texto_Comb, Relativo), by="Tratamiento")
      df_resumen[is.na(df_resumen)] <- "-"
      colnames(df_resumen)[ncol(df_resumen)-1] <- v; colnames(df_resumen)[ncol(df_resumen)] <- paste(v, "Rel")
    }
    
    cols_rel <- grep("Rel$", colnames(df_resumen), value=TRUE); cols_rest <- setdiff(colnames(df_resumen), c("Tratamiento", cols_rel))
    df_resumen <- df_resumen %>% dplyr::select(Tratamiento, dplyr::all_of(cols_rest), dplyr::all_of(cols_rel))
    df_resumen <- df_resumen[order(df_resumen$Tratamiento), ]; df_resumen <- data.frame(`No Trat`=paste0("T", 1:nrow(df_resumen)), df_resumen, check.names=FALSE)
    df_resumen <- df_resumen %>% mutate(across(everything(), as.character))
    
    for(t_p in terminos_p) {
      fila <- c("", paste("P-valor (", t_p, ")", sep=""))
      for(col in colnames(df_resumen)[-c(1,2)]) {
        if(col %in% vars_y) { val <- lista_p[[col]][[t_p]]; fila <- c(fila, ifelse(is.null(val) || is.na(val), "-", ifelse(val < 0.001, "<0.001", sprintf("%.4f", val)))) } else { fila <- c(fila, "") }
      }
      df_resumen <- rbind(df_resumen, fila)
    }
    return(df_resumen)
  })
  
