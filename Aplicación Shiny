  # Función auxiliar para invertir letras de significancia (Ej: ab -> bc)
  rev_let <- function(l_vec) {
    if(all(is.na(l_vec) | l_vec == "")) return(l_vec)
    max_let <- max(unlist(strsplit(l_vec, "")))
    if(!max_let %in% letters) return(l_vec)
    n <- match(max_let, letters); if(n <= 1) return(l_vec)
    orig <- letters[1:n]; revo <- rev(orig)
    unname(sapply(l_vec, function(s) {
      if(is.na(s) || s=="") return(s)
      paste(sort(revo[match(unlist(strsplit(s, "")), orig)]), collapse="")
    }))
  }
  
