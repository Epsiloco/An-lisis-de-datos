      n <- length(Y)
      
      txt_anova <- paste0(txt_anova, "\n", paste(rep("=", 80), collapse = ""), "\n")
      txt_anova <- paste0(txt_anova, " ANÁLISIS DE POLINOMIOS ORTOGONALES PARA: ", toupper(var_y), "\n")
      txt_anova <- paste0(txt_anova, paste(rep("=", 80), collapse = ""), "\n")
      
      txt_modelos <- paste0(txt_modelos, "\n", paste(rep("=", 80), collapse = ""), "\n")
      txt_modelos <- paste0(txt_modelos, " MODELOS DE REGRESIÓN PARA: ", toupper(var_y), "\n")
      txt_modelos <- paste0(txt_modelos, paste(rep("=", 80), collapse = ""), "\n")
      
      tryCatch({
        # 2. Modelo Base y ANOVA
        mod_base <- if (!is.null(replica_name)) lm(Y ~ REP + TR) else lm(Y ~ TR)
        sum_mod <- summary(mod_base)
        cv <- (sqrt(deviance(mod_base)/df.residual(mod_base)) / mean(Y, na.rm=TRUE)) * 100
        
        txt_anova <- paste0(txt_anova, "\nAnálisis de la Varianza (Modelo Base)\n")
        txt_anova <- paste0(txt_anova, sprintf("Variable: %s | N: %d | R2: %.3f | R2 Aj: %.3f | CV: %.2f%%\n", var_y, n, sum_mod$r.squared, sum_mod$adj.r.squared, cv))
        
        # Ajuste de contrastes polinómicos
        txt_anova <- paste0(txt_anova, "\nCuadro de Análisis de la Varianza Desglosado (SC Ortogonal)\n")
        contrasts(TR) <- contr.poly(t)
        mod_aov <- if(!is.null(replica_name)) aov(Y ~ REP + TR) else aov(Y ~ TR)
        
        nombres_grados <- c("lineal", "cuadratico", "cubico", "cuartico", "quintico", "sextico", "septico")
        lista_split <- setNames(as.list(1:grado_max), nombres_grados[1:grado_max])
        txt_anova <- paste0(txt_anova, paste(capture.output(print(summary(mod_aov, split = list(TR = lista_split)))), collapse="\n"), "\n")
        
        tabla_seleccion <- data.frame()
        lista_graficos_y <- list() # Sublista de gráficos para esta variable
        
        # 3. Ciclo de Modelos de Regresión y Gráficos
        for (g in 1:grado_max) {
          nom_g <- toupper(nombres_grados[g])
          
          if (g == 1) { formula_manual <- as.formula("Y ~ TR1") } 
          else {
            terminos <- c("TR1", paste0("I(TR1^", 2:g, ")"))
            formula_manual <- as.formula(paste("Y ~", paste(terminos, collapse = " + ")))
          }
          
          m_reg <- lm(formula_manual)
          s_reg <- summary(m_reg)
          
          # VIF
          v_vif <- "N/A"
          if (g > 1) {
            v_res <- try(car::vif(m_reg), silent = TRUE)
            v_vif <- if(inherits(v_res, "try-error")) "Alta Colinealidad" else paste(round(v_res, 2), collapse = ", ")
          }
          
          tabla_seleccion <- rbind(tabla_seleccion, data.frame(Modelo = nom_g, R2 = s_reg$r.squared, AIC = AIC(m_reg)))
          
          txt_modelos <- paste0(txt_modelos, sprintf("\n>>> MODELO %s <<<\n", nom_g))
          txt_modelos <- paste0(txt_modelos, paste(capture.output(print(coef(s_reg))), collapse="\n"), "\n")
          txt_modelos <- paste0(txt_modelos, sprintf("R2: %.4f | AIC: %.2f | VIF: %s\n", s_reg$r.squared, AIC(m_reg), v_vif))
          
          # --- GRÁFICOS (Guardados en ggplot2 para mejor compatibilidad con Shiny UI) ---
          promedios_y <- aggregate(Y ~ TR1, FUN = mean)
          
          # Creamos un dataframe para la curva suave de predicción
          d_seq <- seq(min(TR1, na.rm=TRUE), max(TR1, na.rm=TRUE), length.out=200)
          pred_df <- data.frame(TR1 = d_seq)
          pred <- predict(m_reg, newdata = pred_df, interval="confidence", level = alfa_conf)
          pred_df$Fit <- pred[,1]; pred_df$Lwr <- pred[,2]; pred_df$Upr <- pred[,3]
          
          p <- ggplot() +
            # Banda de confianza
            geom_ribbon(data = pred_df, aes(x = TR1, ymin = Lwr, ymax = Upr), fill = "#2ecc71", alpha = 0.2) +
            # Línea de tendencia
            geom_line(data = pred_df, aes(x = TR1, y = Fit), color = "darkgreen", size = 1.2) +
            # Puntos promedios reales
            geom_point(data = promedios_y, aes(x = TR1, y = Y), fill = "#3498db", color = "navy", shape = 21, size = 4) +
            theme_bw(base_size = 14) +
            labs(title = paste("Modelo", nom_g, "-", var_y), x = factor_dosis, y = paste("Promedio", var_y))
          
          lista_graficos_y[[nom_g]] <- p
        }
        
        # Unimos los gráficos de los diferentes grados en un solo panel para esta variable
        if(length(lista_graficos_y) > 0) {
          lista_graficos[[var_y]] <- patchwork::wrap_plots(lista_graficos_y, ncol = min(2, length(lista_graficos_y)))
        }
        
        txt_modelos <- paste0(txt_modelos, "\n--- RESUMEN DE SELECCIÓN DE MODELOS ---\n")
        txt_modelos <- paste0(txt_modelos, paste(capture.output(print(tabla_seleccion)), collapse="\n"), "\n")
        
      }, error = function(e) {
        txt_anova <- paste0(txt_anova, "\n[!] Error en el análisis: ", e$message, "\n")
      })
    }
    
    # 4. Enviar resultados a la UI
    vals$poly_anova_txt <- txt_anova
    vals$poly_models_txt <- txt_modelos
    vals$poly_plots <- lista_graficos
  })
  
