  output$dyn_rep_ui <- renderUI({
    req(input$calc_auc == TRUE, vals$datos)
    selectInput("dyn_rep", "Variable de Repetición/Bloque (Requerido para AUC):", choices = c("Seleccione..."="", names(vals$datos)))
  })
  
  observeEvent(input$run_dyn, {
    req(vals$datos, input$dyn_time, input$dyn_y, input$dyn_trt)
    df <- vals$datos
    t_var <- input$dyn_time
    y_var <- input$dyn_y
    trt_var <- input$dyn_trt
    
    # Para AUC y curva temporal, tiempo e Y deben ser numéricos
    df[[y_var]] <- as.numeric(as.character(df[[y_var]]))
    df[[t_var]] <- suppressWarnings(as.numeric(as.character(df[[t_var]])))
    df <- df[!is.na(df[[t_var]]) & !is.na(df[[y_var]]), ]
    
    # 1. GRÁFICA DE DINÁMICA POBLACIONAL CLÁSICA
    df_sum <- df %>% group_by(across(all_of(c(t_var, trt_var)))) %>% summarise(Media = mean(.data[[y_var]], na.rm=TRUE), .groups="drop")
    df_sum <- drop_na(df_sum)
    
    p <- ggplot(df_sum, aes_string(x = t_var, y = "Media", color = trt_var, group = trt_var)) + 
      geom_line(linewidth = 1.5) + 
      geom_point(size = 4, shape = 21, fill = "white", stroke = 2) + 
      scale_color_brewer(palette = input$dyn_palette) + 
      theme_classic(base_size=16) + 
      labs(title=input$dyn_title, x=t_var, y=y_var) +
      theme(legend.position = "right", legend.title = element_text(face="bold"))
    
    if(input$show_ude) p <- p + geom_hline(yintercept=input$val_ude, color=input$col_ude, linetype="dashed", linewidth=1.2) + annotate("text", x=min(df[[t_var]]), y=input$val_ude, label=input$label_ude, vjust=-0.8, hjust=0, color=input$col_ude, fontface="bold", size=5)
    if(input$show_nde) p <- p + geom_hline(yintercept=input$val_nde, color=input$col_nde, linetype="dotted", linewidth=1.2) + annotate("text", x=min(df[[t_var]]), y=input$val_nde, label=input$label_nde, vjust=-0.8, hjust=0, color=input$col_nde, fontface="bold", size=5)
    
    p <- p + coord_cartesian(ylim=c(input$dyn_ymin, input$dyn_ymax))
    vals$p_dyn <- p
    output$plot_dinamica <- renderPlot({ p }, res = 120)
    
    # 2. CÁLCULO Y GRÁFICOS DEL ÁREA BAJO LA CURVA (AUC)
    if(input$calc_auc) {
      req(input$dyn_rep)
      rep_var <- input$dyn_rep
      
      tryCatch({
        # Gráfico 2: Curva de Área Sombreada (Facetado)
        p_area <- ggplot(df_sum, aes_string(x = t_var, y = "Media", fill = trt_var)) +
          geom_area(alpha = 0.4, position = "identity", color="black", linewidth=0.5) +
          geom_point(shape = 21, fill = "white", size = 2.5, stroke=1.5, aes_string(color=trt_var)) +
          facet_wrap(as.formula(paste("~", trt_var))) +
          scale_fill_brewer(palette = input$dyn_palette) +
          scale_color_brewer(palette = input$dyn_palette) +
          theme_bw(base_size=15) +
          labs(title="Progresión Acumulada de la Plaga (Volumen de Presión)", x=t_var, y=paste("Media de", y_var)) +
          theme(legend.position="none", strip.background = element_rect(fill="#2c3e50"), strip.text = element_text(color="white", face="bold", size=12))
        
        p_area <- p_area + coord_cartesian(ylim=c(input$dyn_ymin, input$dyn_ymax))
        vals$p_dyn_area <- p_area
        output$plot_dinamica_area <- renderPlot({ p_area }, res=100)
        
        # Cálculo Matemático del AUC por Réplica (Regla del Trapecio)
        calc_auc_trapecio <- function(tiempo, y) {
          if(length(tiempo) < 2) return(NA)
          ord <- order(tiempo); t_ord <- tiempo[ord]; y_ord <- y[ord]
          sum(0.5 * diff(t_ord) * (y_ord[-1] + y_ord[-length(y_ord)]))
        }
        
        df_auc <- df %>% group_by(across(all_of(c(trt_var, rep_var)))) %>% summarise(AUC = calc_auc_trapecio(.data[[t_var]], .data[[y_var]]), .groups="drop")
        
        output$tabla_auc_datos <- renderDT({ datatable(df_auc, extensions = 'Buttons', options = list(dom = 'Bfrtip', buttons = c('copy', 'excel')), rownames = FALSE, class = "cell-border stripe") })
        
        # Resumen de AUC por Tratamiento
        df_auc_sum <- df_auc %>% group_by(across(all_of(trt_var))) %>% summarise(N_Rep = n(), AUC_Media = mean(AUC, na.rm=TRUE), AUC_SD = sd(AUC, na.rm=TRUE), AUC_SE = sd(AUC, na.rm=TRUE)/sqrt(n()), .groups="drop") %>% arrange(AUC_Media)
        
        # Eficacia relativa (comparada con el peor tratamiento, es decir, el de mayor AUC)
        max_auc <- max(df_auc_sum$AUC_Media, na.rm=TRUE)
        df_auc_sum$Control_Relativo <- paste0(round((1 - df_auc_sum$AUC_Media / max_auc) * 100, 2), "%")
        
        # Renombrar para estética final de tabla
        colnames(df_auc_sum) <- c(trt_var, "Réplicas", "AUC Promedio", "Desv. Est.", "Error Est.", "Control Relativo (vs Peor)")
        
        output$tabla_auc_resumen <- renderDT({ datatable(df_auc_sum, options = list(dom = 't', pageLength=15), rownames = FALSE, class = "cell-border stripe") %>% formatRound(columns=c("AUC Promedio", "Desv. Est.", "Error Est."), digits=2) })
        
        # Gráfico 3: Barras de Presión Acumulada AUC
        p_auc <- ggplot(df_auc_sum, aes_string(x = paste0("reorder(`", trt_var, "`, `AUC Promedio`)"), y = "`AUC Promedio`", fill = paste0("`", trt_var, "`"))) +
          geom_bar(stat="identity", color="black", width=0.7) +
          geom_errorbar(aes(ymin=`AUC Promedio`-`Error Est.`, ymax=`AUC Promedio`+`Error Est.`), width=0.2, linewidth=1) +
          scale_fill_brewer(palette = input$dyn_palette) +
          theme_classic(base_size=15) +
          labs(title="Presión Acumulada Total de la Plaga (AUC)", subtitle="Menor AUC indica mejor control poblacional durante el experimento", x=trt_var, y="Área Bajo la Curva (AUC)") +
          theme(legend.position="none", axis.text.x = element_text(angle = 45, hjust = 1, face="bold"))
        
        vals$p_auc <- p_auc
        output$plot_auc <- renderPlot({ p_auc }, res = 100)
        
      }, error=function(e) { showNotification(paste("Error calculando AUC:", e$message), type="error") })
    } else {
      output$plot_auc <- renderPlot({ plot(1, type="n", main="AUC no calculado") })
      output$plot_dinamica_area <- renderPlot({ plot(1, type="n", main="AUC no calculado") })
      output$tabla_auc_datos <- renderDT({ NULL })
      output$tabla_auc_resumen <- renderDT({ NULL })
