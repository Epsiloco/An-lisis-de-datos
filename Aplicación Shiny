  output$mc_ui_trt <- renderUI({ req(vals$datos); selectInput("mc_trt", "Factor (Tratamiento):", choices = names(vals$datos), selected = isolate(input$mv_f_princ)) })
  output$mc_ui_vars <- renderUI({ req(vals$datos); selectizeInput("mc_y", "Variables a evaluar simultáneamente:", choices = names(dplyr::select_if(vals$datos, is.numeric)), multiple = TRUE, selected = isolate(input$mv_y)) })
  
  output$mc_ui_directions <- renderUI({
    req(input$mc_y)
    lapply(input$mc_y, function(v) {
      safe_id <- paste0("mc_dir_", gsub("[^[:alnum:]]", "", v))
      radioButtons(safe_id, paste("Objetivo:", v), choices = c("Maximizar (Más es mejor)" = "max", "Minimizar (Menos es mejor)" = "min"), inline = TRUE)
    })
  })
  
  observeEvent(input$run_mc, {
    req(vals$datos, input$mc_y, input$mc_trt)
    if(length(input$mc_y) < 2) { showNotification("Seleccione al menos 2 variables para calcular el índice.", type="warning"); return() }
    
    df <- vals$datos
    trt_var <- input$mc_trt
    vars_y <- input$mc_y
    
    tryCatch({
      # 1. Calcular Medias Reales
      df_means <- df %>% group_by(across(all_of(trt_var))) %>% summarise(across(all_of(vars_y), ~mean(.x, na.rm=TRUE)), .groups="drop") %>% drop_na()
      
      # 2. Estandarización Inteligente (Escala 0 a 100) basándose en los objetivos (min/max)
      # Esto es crucial para el MTSI: transforma todos los datos para que 100 siempre sea "Lo Mejor" y 0 "Lo Peor".
      df_norm <- df_means
      for(v in vars_y) {
        safe_id <- paste0("mc_dir_", gsub("[^[:alnum:]]", "", v))
        dir <- input[[safe_id]]
        
        mi <- min(df_norm[[v]], na.rm=TRUE)
        ma <- max(df_norm[[v]], na.rm=TRUE)
        
        if(ma == mi) { 
          df_norm[[v]] <- 50 # Si todos son iguales, se asigna punto medio
        } else {
          if(!is.null(dir) && dir == "min") {
            # Si el objetivo es MINIMIZAR, invertimos la escala: el valor menor recibe 100, el mayor 0.
            df_norm[[v]] <- ((ma - df_norm[[v]]) / (ma - mi)) * 100
          } else {
            # Si el objetivo es MAXIMIZAR (default), el valor mayor recibe 100, el menor 0.
            df_norm[[v]] <- ((df_norm[[v]] - mi) / (ma - mi)) * 100
          }
        }
      }
      
      # Exportar tabla estandarizada (Puntuaciones puras)
      output$mc_norm_tbl <- renderDT({
        datatable(df_norm, rownames=FALSE, extensions='Buttons', options=list(dom='Bfrtip', buttons=c('copy', 'excel'), pageLength=15), class="cell-border stripe") %>%
          formatRound(columns=vars_y, digits=2)
      })
      
      # 3. Construir el Ideotipo Virtual y calcular Distancia Euclidiana (MTSI Core)
      # Como ya re-escalamos, el "Ideotipo" ahora siempre es un vector donde todas las variables valen 100.
      df_res <- df_norm %>% select(all_of(trt_var))
      df_res$Distancia_MTSI <- 0
      
      ideotipo_perfecto <- 100
      
      for(v in vars_y) {
        # Sumamos el cuadrado de la diferencia (Distancia geométrica)
        df_res$Distancia_MTSI <- df_res$Distancia_MTSI + (df_norm[[v]] - ideotipo_perfecto)^2
      }
      df_res$Distancia_MTSI <- sqrt(df_res$Distancia_MTSI)
      
      # 4. Calcular el "Score Ideotipo" (Inverso relativo para mejor lectura)
      max_dist <- max(df_res$Distancia_MTSI, na.rm=TRUE)
      min_dist <- min(df_res$Distancia_MTSI, na.rm=TRUE)
      
      # Estandarizamos el Score para que el mejor sea 100% y el peor 0%
      if(max_dist == min_dist) {
        df_res$Score_Similitud <- 50
      } else {
        df_res$Score_Similitud <- ((max_dist - df_res$Distancia_MTSI) / (max_dist - min_dist)) * 100
      }
      
      # Ordenar del mejor (menor distancia, mayor score) al peor
      df_res <- df_res %>% arrange(Distancia_MTSI)
      df_res$Ranking_Global <- 1:nrow(df_res)
      
      # Unir con las medias reales para la tabla final
      df_final <- df_res %>% left_join(df_means, by=trt_var) %>% select(Ranking_Global, all_of(trt_var), Score_Similitud, Distancia_MTSI, all_of(vars_y))
      
      # --- RESULTADOS TEXTO Y ESTADÍSTICA ---
      output$mc_interpretacion <- renderPrint({
        ganador <- df_final[[trt_var]][1]
        score_ganador <- df_final$Score_Similitud[1]
        dist_ganador <- df_final$Distancia_MTSI[1]
        
        peor <- df_final[[trt_var]][nrow(df_final)]
        dist_peor <- df_final$Distancia_MTSI[nrow(df_final)]
        
        cat("=================================================================\n")
        cat(" 🏆 DIAGNÓSTICO ESTADÍSTICO MTSI (Toma de Decisión Agronómica)\n")
        cat("=================================================================\n\n")
        cat("MÉTODO:\n")
        cat("- Se escalaron todas las variables del 0 al 100 respetando su sentido biológico (Maximizar o Minimizar).\n")
        cat("- Se definió un 'Ideotipo' virtual con una puntuación perfecta de 100 en cada atributo evaluado.\n")
        cat("- Se calculó la Distancia Geométrica Euclidiana entre cada tratamiento real y el Ideotipo.\n\n")
        
        cat("RESULTADO FINAL:\n")
        cat("-> El tratamiento más cercano al 'Ideotipo' (Planta Perfecta) es: [", as.character(ganador), "]\n\n")
        
        cat("ESTADÍSTICAS DEL GANADOR:\n")
        cat("- Distancia Geométrica Mínima:", round(dist_ganador, 2), "unidades.\n")
        cat("- Score Relativo de Similitud:", round(score_ganador, 1), "% (Referenciado al pool de tratamientos evaluados).\n\n")
        
        cat("INTERPRETACIÓN PRÁCTICA:\n")
        cat("Considerando todas las variables evaluadas simultáneamente, el tratamiento", as.character(ganador))
        cat(" es la mejor decisión técnica, ya que presenta la desviación global más baja respecto a las metas agronómicas planteadas, ")
        cat("ofreciendo el mayor equilibrio entre las ganancias y pérdidas de las diferentes variables.\n")
      })
      
      # --- GRÁFICO RANKING ---
      output$mc_ranking_plot <- renderPlot({
        p_rank <- ggplot(df_final, aes_string(x = paste0("reorder(", trt_var, ", -Distancia_MTSI)"), y = "Distancia_MTSI", fill = "Score_Similitud")) +
          geom_bar(stat="identity", color="black", width=0.6) +
          coord_flip() +
          scale_fill_viridis_c(option="plasma", direction=-1, name="Score\nSimilitud %") +
          theme_minimal(base_size = 15) +
          labs(x="Tratamientos", y="Distancia al Ideotipo MTSI (Menor es Mejor)", title="Ranking de Estabilidad Multi-Atributo") +
          theme(axis.text.y = element_text(face="bold"))
        print(p_rank)
      })
      
      # --- TABLA DATOS ESTADÍSTICOS ---
      output$mc_ranking_tbl <- renderDT({
        datatable(df_final, rownames=FALSE, extensions='Buttons', options=list(dom='Bfrtip', buttons=c('copy', 'excel'), pageLength=15), class="cell-border stripe") %>%
          formatRound(columns=c("Score_Similitud", "Distancia_MTSI", vars_y), digits=2)
      })
      
      # --- MAPA DE CALOR (Heatmap de Perfil) - Puntuaciones ---
      output$mc_heatmap_plot <- renderPlot({
        df_melt <- df_norm %>% pivot_longer(cols=all_of(vars_y), names_to="Variable", values_to="Puntuacion_0_100")
        df_melt[[trt_var]] <- factor(df_melt[[trt_var]], levels = rev(df_final[[trt_var]]))
        
        p_heat <- ggplot(df_melt, aes_string(x="Variable", y=trt_var, fill="Puntuacion_0_100")) +
          geom_tile(color="white", linewidth=1) +
          scale_fill_gradient2(low="#e74c3c", mid="#f1c40f", high="#27ae60", midpoint=50, name="Aptitud\n(100=Ideal)") +
          geom_text(aes(label=round(Puntuacion_0_100, 1)), color="black", size=5, fontface="bold") +
          theme_minimal(base_size=15) +
          labs(x="Variables Evaluadas", y="Tratamientos (Ordenados: Peor Abajo, Mejor Arriba)", title="Perfil de Fortalezas: Desglose de la Puntuación por Variable") +
          theme(axis.text.x = element_text(angle=45, hjust=1, face="bold"), axis.text.y = element_text(face="bold"))
        
        vals$p_mc_heat <- p_heat
        print(p_heat)
      })
      
      # --- NUEVO: MAPA DE CALOR CON VALORES REALES ---
      output$mc_heatmap_real_plot <- renderPlot({
        # 1. Derretir la tabla de puntuaciones (para los colores)
        df_melt_norm <- df_norm %>% pivot_longer(cols=all_of(vars_y), names_to="Variable", values_to="Puntuacion_0_100")
        
        # 2. Derretir la tabla de medias reales (para el texto)
        df_melt_means <- df_means %>% pivot_longer(cols=all_of(vars_y), names_to="Variable", values_to="Valor_Real")
        
        # 3. Unir ambas tablas
        df_melt_combined <- left_join(df_melt_norm, df_melt_means, by = c(trt_var, "Variable"))
        
        # 4. Ordenar los tratamientos según el ranking final del MTSI
        df_melt_combined[[trt_var]] <- factor(df_melt_combined[[trt_var]], levels = rev(df_final[[trt_var]]))
        
        p_heat_real <- ggplot(df_melt_combined, aes_string(x="Variable", y=trt_var, fill="Puntuacion_0_100")) +
          geom_tile(color="white", linewidth=1) +
          # El color de fondo se mantiene basado en la aptitud para guiar visualmente
          scale_fill_gradient2(low="#e74c3c", mid="#f1c40f", high="#27ae60", midpoint=50, name="Aptitud\n(100=Ideal)") +
          # EL TEXTO AHORA ES EL VALOR REAL (TCH, Rendimiento, etc.)
          geom_text(aes(label=round(Valor_Real, 2)), color="black", size=5, fontface="bold") +
          theme_minimal(base_size=15) +
          labs(x="Variables Evaluadas", y="Tratamientos (Ordenados: Peor Abajo, Mejor Arriba)", title="Perfil de Valores Agronómicos (Colores por Aptitud)") +
          theme(axis.text.x = element_text(angle=45, hjust=1, face="bold"), axis.text.y = element_text(face="bold"))
        
        vals$p_mc_heat_real <- p_heat_real
        print(p_heat_real)
      })
      
    }, error=function(e) showNotification(paste("Error en Multi-Criterio:", e$message), type="error"))
  })
  
  observeEvent(input$btn_pop_mc_heat, { req(vals$p_mc_heat); if(interactive()){ dev.new(noRStudioGD=T, width=12, height=8); print(vals$p_mc_heat) } })
  
  # --- NUEVO: Botón emergente para el mapa de calor con valores reales ---
  observeEvent(input$btn_pop_mc_heat_real, { req(vals$p_mc_heat_real); if(interactive()){ dev.new(noRStudioGD=T, width=12, height=8); print(vals$p_mc_heat_real) } })
  
  # =====================================================================
  # --- MÓDULO: GRÁFICOS ESPECIALES (BARRAS AVANZADAS) ---
  # =====================================================================
  
  output$sp_bar_vars_ui <- renderUI({
    req(vals$datos)
    vars <- names(vals$datos)
    num_vars <- names(dplyr::select_if(vals$datos, is.numeric))
    
    tagList(
      selectInput("sp_bar_y", "Variable Numérica (Y):", choices = num_vars),
      selectInput("sp_bar_x", "Variable de Agrupación (Eje X):", choices = vars),
      selectInput("sp_bar_facet", "Facetar por (Opcional):", choices = c("Ninguno"="", vars)),
      selectInput("sp_bar_color_by", "Colorear barras por:", choices = c("Mismo que Eje X"="x", "Mismo que Faceta"="facet"))
