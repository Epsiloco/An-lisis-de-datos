      mod_temp <- aov(as.formula(form_str), data = df_clean)
      res_anova <- summary(mod_temp)[[1]]; p_val <- res_anova[trt_var, "Pr(>F)"]; p_valores <- c(p_valores, ifelse(p_val < 0.001, "<0.001", sprintf("%.4f", p_val)))
      
