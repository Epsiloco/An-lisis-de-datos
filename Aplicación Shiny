    testigo_u <- isolate(input$mv_resumen_testigo)
    pares <- combn(levels(df[[f_p]]), 2, simplify = FALSE)
    res_h <- do.call(rbind, lapply(pares, function(p) {
      sub_df <- df[df[[f_p]] %in% p, ]
      p_v <- tryCatch(summary(manova(as.formula(paste("cbind(", paste(deps, collapse=","), ") ~", f_p)), data = sub_df), test = "Pillai")$stats[1, 6], error=function(e) NA)
      data.frame(T1 = p[1], T2 = p[2], P_Hotelling = p_v)
    }))
    
    if(nrow(res_h) > 0 && !all(is.na(res_h$P_Hotelling))) {
