      alpha_val <- input$sim_alpha; test_name <- input$sim_pmm
      asc_vars <- input$sim_order_asc # Capturamos las variables marcadas para orden ascendente
      
      for(y_var in input$sim_y) {
        vars_to_keep <- c(y_var, trt_var, covs); if(input$sim_des == "DBCA") vars_to_keep <- c(vars_to_keep, input$sim_blk); if(input$sim_des == "DCL") vars_to_keep <- c(vars_to_keep, input$sim_row, input$sim_col)
        df_clean <- df[complete.cases(df[, vars_to_keep]), ]; df_clean[[y_var]] <- as.numeric(as.character(df_clean[[y_var]])); df_clean <- droplevels(df_clean); if(nrow(df_clean) < 2) next
        form_str <- switch(input$sim_des, "DCA" = paste(y_var, "~", cov_str, trt_var), "DBCA" = paste(y_var, "~", cov_str, trt_var, "+", input$sim_blk), "DCL" = paste(y_var, "~", cov_str, trt_var, "+", input$sim_row, "+", input$sim_col))
        modelo <- aov(as.formula(form_str), data = df_clean)
        txt_pmm <- paste0(txt_pmm, "\n================ PRUEBA DE MEDIAS PARA: ", toupper(y_var), " ================\n")
        txt_pmm <- paste0(txt_pmm, "Prueba: ", test_name, " | Alpha: ", alpha_val, "\n\n")
        
        # Asignamos FALSE si el usuario marcó la variable en el input (reversed = FALSE en agricolae)
        es_cons_desc <- !(y_var %in% asc_vars)
        
        tryCatch({ 
          if(test_name == "Tukey") { out <- capture.output(print(agricolae::HSD.test(modelo, trt_var, alpha = alpha_val, console = TRUE, group = TRUE, main = y_var))); txt_pmm <- paste0(txt_pmm, paste(out[-(1:10)], collapse="\n"), "\n") } 
          else if(test_name == "Fisher (LSD)") { out <- capture.output(print(agricolae::LSD.test(modelo, trt_var, p.adj = "none", alpha = alpha_val, console = TRUE, group = TRUE, main = y_var))); txt_pmm <- paste0(txt_pmm, paste(out[-(1:10)], collapse="\n"), "\n") } 
          else if(test_name == "Duncan") { out <- capture.output(print(agricolae::duncan.test(modelo, trt_var, alpha = alpha_val, console = TRUE, group = TRUE, main = y_var))); txt_pmm <- paste0(txt_pmm, paste(out[-(1:10)], collapse="\n"), "\n") } 
          else if(test_name == "SNK") { out <- capture.output(print(agricolae::SNK.test(modelo, trt_var, alpha = alpha_val, console = TRUE, group = TRUE, main = y_var))); txt_pmm <- paste0(txt_pmm, paste(out[-(1:10)], collapse="\n"), "\n") } 
          else if(test_name == "Bonferroni") { out <- capture.output(print(agricolae::LSD.test(modelo, trt_var, p.adj = "bonferroni", alpha = alpha_val, console = TRUE, group = TRUE, main = y_var))); txt_pmm <- paste0(txt_pmm, paste(out[-(1:10)], collapse="\n"), "\n") } 
          else if(test_name == "Scott-Knott") { sk <- ScottKnott::SK(modelo, which = trt_var, sig.level = alpha_val, dispersion="se"); txt_pmm <- paste0(txt_pmm, paste(capture.output(summary(sk)), collapse="\n"), "\n") } 
        }, error = function(e) txt_pmm <- paste0(txt_pmm, "Fallo en PMM: ", e$message, "\n"))
      }
      cat(txt_pmm)
    })
    
    lista_supuestos <- list(); lista_graficos_pmm <- list()
    asc_vars <- input$sim_order_asc
    
    for(y_var in input$sim_y) {
      local({
        y_v <- y_var
        vars_to_keep <- c(y_v, trt_var, covs); if(input$sim_des == "DBCA") vars_to_keep <- c(vars_to_keep, input$sim_blk); if(input$sim_des == "DCL") vars_to_keep <- c(vars_to_keep, input$sim_row, input$sim_col)
        df_clean <- df[complete.cases(df[, vars_to_keep]), ]; df_clean[[y_v]] <- as.numeric(as.character(df_clean[[y_v]])); df_clean <- droplevels(df_clean); if(nrow(df_clean) < 2) return()
