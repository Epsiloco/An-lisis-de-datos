    variables_y <- input$cont_y
    fac <- input$cont_f_princ
    bloq <- input$cont_f_bloq
    alfa <- input$cont_alfa
    adj <- input$cont_adj
    tipo_prueba <- input$cont_tipo
    
    # Preparación de datos
    df[[fac]] <- as.factor(trimws(as.character(df[[fac]])))
    niveles_reales <- levels(df[[fac]])
    if(bloq != "") df[[bloq]] <- as.factor(df[[bloq]])
    
    resultado_texto <- ""
    
    # Bucle por variable de respuesta
    for(v in variables_y) {
      df[[v]] <- suppressWarnings(as.numeric(as.character(df[[v]])))
      df_limpio <- df[!is.na(df[[v]]), ]
      if(nrow(df_limpio) < 3) next
      
      resultado_texto <- paste0(resultado_texto, "\n", paste(rep("=", 60), collapse = ""), "\n")
      resultado_texto <- paste0(resultado_texto, " ANÁLISIS PARA LA VARIABLE: ", toupper(v), "\n")
      resultado_texto <- paste0(resultado_texto, paste(rep("=", 60), collapse = ""), "\n")
      
      tryCatch({
        # 1. Ajuste del Modelo (con o sin bloque)
        form_str <- paste(v, "~", ifelse(bloq=="", fac, paste(bloq, "+", fac)))
        modelo <- aov(as.formula(form_str), data = df_limpio)
        emm <- emmeans::emmeans(modelo, as.formula(paste("~", fac)))
        
        resultado_texto <- paste0(resultado_texto, "Modelo Ajustado: ", form_str, "\n")
        resultado_texto <- paste0(resultado_texto, "Ajuste de P-valor: ", adj, "\n\n")
        
        # 2. Ejecución de la Prueba Solicitada
        if(tipo_prueba == "1. Dunnett (Todos vs Un Testigo)") {
          req(input$cont_dunnett_ref)
          testigo <- input$cont_dunnett_ref
          pos_ref <- which(niveles_reales == testigo)
          
          if(length(pos_ref) == 0) stop("Testigo no encontrado en los datos.")
          
          resultado_texto <- paste0(resultado_texto, "[ PRUEBA DE DUNNETT (vs ", testigo, ") ]\n")
          # En Dunnett, el ajuste suele manejarse internamente por emmeans si se usa 'dunnetttx' o el default de la prueba
          # Para forzar un ajuste particular, lo pasamos a test()
          res_dunnett <- summary(emmeans::contrast(emm, method = "dunnett", ref = pos_ref), infer = TRUE, adjust = ifelse(adj=="none", "none", "dunnett"))
          resultado_texto <- paste0(resultado_texto, paste(capture.output(print(res_dunnett)), collapse="\n"), "\n")
          
        } else {
          # Pruebas Personalizadas (Pares o Grupos Ortogonales)
          lista_custom <- lista_contrastes_custom()
          if(length(lista_custom) == 0) {
            resultado_texto <- paste0(resultado_texto, "[!] No se han añadido comparaciones a la lista.\n")
            next
          }
          
          # --- El Generador Automático de Coeficientes (Magia aquí) ---
          # Construye una lista de vectores c(1, -1, 0...) entendible por emmeans
          vectores_contraste <- list()
          for(nombre_cont in names(lista_custom)) {
            elementos_A <- lista_custom[[nombre_cont]]$GrupoA
            elementos_B <- lista_custom[[nombre_cont]]$GrupoB
            
            # Asignamos pesos matemáticos para hacer la prueba. 
            # Si A tiene 2 elementos y B tiene 1, los pesos de A serán 1, y el de B será -2.
            peso_A <- length(elementos_B)
            peso_B <- -length(elementos_A)
            
            vec <- rep(0, length(niveles_reales))
            vec[which(niveles_reales %in% elementos_A)] <- peso_A
            vec[which(niveles_reales %in% elementos_B)] <- peso_B
            
            vectores_contraste[[nombre_cont]] <- vec
          }
          
          resultado_texto <- paste0(resultado_texto, "[ CONTRASTES PERSONALIZADOS ]\n")
          
          # Mostrar la Matriz de Coeficientes generada
          matriz_coef <- do.call(rbind, vectores_contraste)
          colnames(matriz_coef) <- niveles_reales
          resultado_texto <- paste0(resultado_texto, "\nMatriz de Coeficientes Utilizada:\n")
          resultado_texto <- paste0(resultado_texto, paste(capture.output(print(matriz_coef)), collapse="\n"), "\n\n")
          
          # Ejecutar el test
          tab_man <- emmeans::test(emmeans::contrast(emm, method = vectores_contraste), adjust = adj)
          resultado_texto <- paste0(resultado_texto, paste(capture.output(print(tab_man[, c("contrast", "estimate", "t.ratio", "p.value")])), collapse="\n"), "\n")
        }
        
        # 3. Letras / Clasificación de Medias Global (Contexto extra útil)
        resultado_texto <- paste0(resultado_texto, "\n[ CLASIFICACIÓN DE MEDIAS (CLD) ]\n")
        # Aseguramos que cld usa el mismo ajuste solicitado
        res_letras <- multcomp::cld(emm, alpha = alfa, Letters = letters, reversed = TRUE, adjust = adj)
        resultado_texto <- paste0(resultado_texto, paste(capture.output(print(res_letras)), collapse="\n"), "\n")
        
        # 4. Diagnóstico Rápido
        mejor_trat <- as.character(res_letras[1, fac])
        resultado_texto <- paste0(resultado_texto, "\n-> El tratamiento con media aritmética más alta es: ", mejor_trat, "\n")
        
      }, error = function(e) {
        resultado_texto <<- paste0(resultado_texto, "\n[!] Error en el análisis: ", e$message, "\n")
      })
    }
    
    # Imprimir en UI
    output$contrastes_resultados_out <- renderPrint({ cat(resultado_texto) })
  })
  
